# Salin file ini menjadi .env, lalu isi dengan API key kamu sendiri.
#
#   cp .env.example .env
#
# API key gratis didapat di https://www.omdbapi.com/apikey.aspx
# Jangan lupa klik link aktivasi yang dikirim ke email.
#
# Nama variabel WAJIB diawali VITE_ supaya terbaca Vite.
# Setelah mengubah file .env, restart server dev (Ctrl+C lalu npm run dev).

VITE_OMDB_API_KEY=masukkan_key_kamu_di_sini
